{room, name=Lazer Gun Room, key=lazer_room
    {enter_message
        output={@
You are in the lazer gun room.

        }
    }

    {look
        {message
            output={@
You look around...
This is the lazer gun test room.

            }
        }
    }

    {inject, logic=/nav_home.inj }
    {inject, logic=/home.inj }
    {inject, logic=/look.inj }
}
