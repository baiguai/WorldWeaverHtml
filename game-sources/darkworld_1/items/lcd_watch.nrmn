{object, key=lcd_watch, name=LCD Watch, parent=toplessrobot_bedroom
    {attrib, tags=moved, output=false }

    {x_in_dresser
        {message
            output={@
<?[self]((moved)) = 'false'?>
They are all empty, except the last one you look in.
In that drawer you see a tech-looking LCD watch.
</?>
            }
        }
    }

    {look
        {message
            output={@
You see an LCD watch.
            }
        }

        {logic, logic=[self]parent = [room] }
    }

    {x_lcd_watch
        {message
            output={@
You examine the LCD watch...
            }
        }
    }


    {input, syntax=[tplt_syntax]((x_lcd_watch))
        {act, logic=x_lcd_watch, tags=!_type|self }
    }

	{input, syntax=[tplt_syntax]((lcd_watch_take))
		{move, logic=[player], tags=[self]
			output={@
You take the watch.
			}
		}
		{set, logic=[self]tags, output=+inventory }
		{set, logic=[self]((moved)), output=true }
        {set, logic=[player]((quest)), output= }

		{logic, logic=[self]parent != [player]
			output={@
You already have the watch.
			}
		}
	}

	{input, syntax=[tplt_syntax]((lcd_watch_drop))
		{move, logic=[room], tags=[self]
			output={@
You drop the watch.
			}
		}
		{set, logic=[self]tags, output=-inventory }
		{logic, logic=[self]parent = [player]
			output={@
You aren't carrying a watch.
			}
		}
	}
}
