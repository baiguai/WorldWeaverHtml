{room, key=mailroom_closet, name=Closet
    {attrib, output=true, tags=tested }
    {attrib, output=false, tags=panel_removed }
    {attrib, tags=navigation
        output={@
South - return to the mail room.
        }
    }


    {enter_message
        output={@
It is a small dark room.

You see shelves of cleaning supplies lining the walls.
There doesn't seem to be anything odd about the closet.
That's when you notice it...

There is an odd looking panel set into the wall to your right.
<?[room]((panel_removed)) = 'true'?>

It has been removed, you can enter it using: enter panel
</?>
        }

        {logic, name=Deepgrid mailroom closet tested, tags=!_test
            logic={@
                ?[self]((tested)) = 'true'
            }
        }
    }

    {look
        {message
            output={@
The closet is small and dark.

You see shelves of cleaning supplies lining the walls.
There doesn't seem to be anything odd about the closet.
That's when you notice it...

There is an odd looking panel set into the wall to your right.
<?[room]((panel_removed)) = 'true'?>

It has been removed, you can enter it using: enter panel
</?>

            }
        }
    }



    {inject, logic=/nav.inj }
    {inject, logic=/look.inj }

    {inject, logic=./injections/cleaning_supp.inj }
    {inject, logic=./injections/weird_panel.inj }



    {input, syntax=[tplt_syntax]((go_south))
        {move, logic=deepgrid_floor_33, tags=[player]
            output={@
You return to the mail room.
            }
        }
    }
}
