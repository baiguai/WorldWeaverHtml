{object, key=lazer_gun, name=Lazer Gun, syntax=[tplt_syntax]((lazergun_id)), parent=assassins_room, tags=!_weapon
    {attrib, logic=[roll:(4)2d8], tags=!_damage }
    {attrib, output=a lazer gun, tags=!_title }
    {attrib, output=5, tags=cur_ammo }
    {attrib, output=5, tags=max_ammo }
    {attrib, output=Your lazer gun needs to be recharged., tags=!_cantattack }
    {attrib, output=false, tags=moved }

    {enter_message
        output={@
You see a lazer gun.
        }

        {logic
            logic={@
                ?[self]parent = [room]
                and
                ?[self]((moved)) = 'true'
            }
        }
    }

    {look
        {message
            output={@
You see a lazer gun.
            }
        }

        {logic
            logic={@
                ?[self]parent = [room]
                and
                ?[self]((moved)) = 'true'
            }
        }
    }

    {x_gun
        {message
            output={@
You examine the lazer gun.
It is sleek and made completely of polished chrome.
            }
        }
    }



    {ammo
        {message
            output={@
You've used some ammo.
            }
        }

        {logic
            logic={@
                ?[self]((cur_ammo)) > '0'
            }
        }
        {set, logic=[self]((cur_ammo)), output=-- }
        {act, logic=fix_min_ammo, tags=!_type|self }
    }
    {fix_min_ammo
        {logic
            logic={@
                ?[self]((cur_ammo)) < '0'
            }
        }
        {set, logic=[self]((cur_ammo)), output=0 }
    }



    {input, syntax=[tplt_syntax]((x_lazergun))
        {act, logic=x_gun, tags=!_type|self }
    }

    {input, syntax=[tplt_syntax]((lazergun_take))
        {move, logic=[player], tags=[self]
            output={@
You take the lazer gun.
            }
        }
        {set, logic=[self]tags, output=+inventory }
        {set, logic=[self]((moved)), output=true }
    }

    {input, syntax=[tplt_syntax]((lazergun_drop))
        {move, logic=[room], tags=[self]
            output={@
You drop the lazer gun.
            }
        }
        {set, logic=[self]tags, output=-inventory }
        {logic, logic=?[self]parent = [player]
            output={@
You aren't carrying that item.
            }
        }
    }
}
