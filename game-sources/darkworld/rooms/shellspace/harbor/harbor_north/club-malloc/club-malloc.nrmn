        output={@
West: exit the club
        }
    }

    {enter_message
        {act, logic=story, tags=!_type|room }
    }

    {story
        {message
            output={@

...

            }
        }
    }

    {look
        {message
            output={@

...

            }
        }

        {logic, name=Club Malloc tested, tags=!_test
            logic={@
                ?[self]((tested)) = 'true'
            }
        }
    }


    {inject, logic=/nav.inj }
    {inject, logic=/look.inj }


    
    {input, syntax=[tplt_syntax]((go_west))
