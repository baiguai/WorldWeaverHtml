{room, key=malloc_secret_storage, name=Secret Storage Room
    {attrib, output=false, tags=tested }
    {attrib, tags=navigation
        output={@
South: back to the storage room
        }
    }

    {enter_message
        {act, logic=story, tags=!_type|room }
    }

    {story
        {message
            output={@

You find yourself in a strange looking room.
It kind of glitches here and there.
In the center of the room is an orb, floating one meter above the floor.

            }
        }
    }

    {look
        {message
            output={@

The entire room kind of glitches here and there.
It is a cube shape and is completely empty.
In the center of the room is an orb, floating one meter above the floor.

            }
        }

        {logic, name=Secret Storage Room tested, tags=!_test
            logic={@
                ?[self]((tested)) = 'true'
            }
        }
    }


    {inject, logic=/nav.inj }
    {inject, logic=/look.inj }


    {inject, logic=./objects/the_orb.inj }



    {input, syntax=[tplt_syntax]((go_south))
        {move, logic=club_malloc_storage, tags=[player]
            output={@

You return to the storage room, replacing the panel as you had found it.

            }
        }
    }



    {dev_note, tags=testing, active=true
        output={@
[ ] : room
[ ] : look
[ ] : story

[ ] : navigation
        }
    }
}
