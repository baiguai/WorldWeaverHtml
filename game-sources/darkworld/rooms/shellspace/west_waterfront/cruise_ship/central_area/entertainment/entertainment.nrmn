{room, key=cruise_entertainment, name=Entertainment Area
    {attrib, tags=navigation
        output={@
East to the central area of the cruise ship.
        }
    }

    {enter_message
        output={@
You enter the entertainment area.
The north, west, and south walls are completely composed of outward curving
windows.
The floor of the room is filled with small round tables and chairs arranged
around them.
Groups of patrons are quietly discussing among themselves.
        }
    }

    {look
        {message
            output={@
You look around the entertainment area...
The north, west, and south walls are completely composed of outward curving
windows.
The floor of the room is filled with small round tables and chairs arranged
around them.
Groups of patrons are quietly discussing among themselves.
            }
        }
    }


    {inject, logic=/nav.inj }
    {inject, logic=/look.inj }


    {input, syntax=[tplt_syntax]((go_east))
        {move, logic=cruise_central_area, tags=[player]
            output={@
You return to the central area of the cruise ship.
            }
        }
    }
}
