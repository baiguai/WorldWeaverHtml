{room, key=op_club, name=OP Club
    {attrib, output=false, tags=tested }

    {enter_message
        output={@
"Welcome to Club OP."
        }

        {logic, name=OP Club, tags=!_test
            logic={@
                ?[self]((tested)) = 'true'
            }
        }
    }

    {look
        {message
            output={@
You look around.
            }
        }
    }


    {inject, logic=/nav.inj }
    {inject, logic=/look.inj }



}
