{room, key=cruise_top_adults, name=Adults Only Area
    {attrib, output=true, tags=tested }
    {attrib, tags=navigation
        output={@
North, top deck, railing.
        }
    }

    {enter_message
        output={@
You are in the adults-only pool area on the cruise ship's top deck.
There are several women lounging on chairs, topless and a few men
in small speedos relaxing under the pulsating lights of the virtual
sky above.
Energetic dance music is playing over the large speakers that surround
the lit up pool.

Two couples are in the pool talking among themselves.
        }

        {logic, name=Cruise ship upper adult area, tags=!_test
            logic={@
                ?[self]((tested)) = 'true'
            }
        }
    }

    {look
        {message
            output={@
You look around.
Groups of adults are lounging on their chairs under the pulsating lights
of the virtual sky.
            }
        }
    }

    {x_women
        {message
            output={@
You examine the topless women.
They are lounging on chairs, talking among themselves.
            }
        }
    }

    {x_men
        {message
            output={@
You examine the men.
They are relaxing, and are mostly silent.
            }
        }
    }

    {x_groups
        {message
            output={@
You see groups of adults talking and laughing among themselves.
            }
        }
    }

    {x_couples
        {message
            output={@
You examine the couples.
            }
        }
    }




    {inject, logic=/nav.inj }
    {inject, logic=/look.inj }



    {input, syntax=[tplt_syntax]((x_topless_women))
        {act, logic=x_women, tags=!_type|room }
    }

    {input, syntax=[tplt_syntax]((x_men))
        {act, logic=x_men, tags=!_type|room }
    }

    {input, syntax=[tplt_syntax]((x_couples))
        {act, logic=x_couples, tags=!_type|room }
    }

    {input, syntax=[tplt_syntax]((x_groups))
        {act, logic=x_groups, tags=!_type|room }
    }

    {input, syntax=[tplt_syntax]((go_north))
        {move, logic=cruise_top_deck, tags=[player]
            output={@
You go north.
            }
        }
    }
}
