{room, key=cruise_top_pool, name=Pool Area
    {attrib, output=true, tags=tested }

    {attrib, tags=navigation
        output={@
South, top deck, railing.
        }
    }

    {enter_message
        output={@
You are in the pool area.
Children and adults are bobbing in the pool.
Overhead there are numerous water slides filled with people
screaming as they shoot down the twisting tubes.

There are a couple of hot tubs in this area, filled with
adults conversing with one another.
        }

        {logic, name=Cruise ship pool area, tags=!_test
            logic={@
                ?[self]((tested)) = 'true'
            }
        }
    }

    {look
        {message
            output={@
You look around, you are in the pool area
and the various water slides overhead.

Scattered throughout are a couple of hot tubs.
            }
        }

        {logic, name=Player has the access chip, tags=!_test
            logic={@
                ?[invite_chip]parent = [player]
            }
        }
    }

    {x_slides
        {message
            output={@
The slides are surprisingly extreme. They are steep tubes with loops and sharp
curves.
            }
        }
    }

    {x_pools
        {message
            output={@
The pools are full of adults and children swimming and having fun.
            }
        }
    }

    {x_hottubs
        {message
            output={@
The hot tubs are full of adults, relaxing and discussing various topics among
themselves.
            }
        }
    }



    {inject, logic=/nav.inj }
    {inject, logic=/look.inj }


    {input, syntax=[tplt_syntax]((x_slides))
        {act, logic=x_slides, tags=!_type|room }
    }
    {input, syntax=[tplt_syntax]((x_pools))
        {act, logic=x_pools, tags=!_type|room }
    }
    {input, syntax=[tplt_syntax]((x_hottubs))
        {act, logic=x_hottubs, tags=!_type|room }
    }

    {input, syntax=[tplt_syntax]((go_south))
        {move, logic=cruise_top_deck, tags=[player]
            output={@
You go south.
            }
        }
    }


    {dev_note, tags=TODO
        output={@
* Define how to read the chip.
* Define the clue that it gives.
* Define joining the secret society.
        }
    }
}
