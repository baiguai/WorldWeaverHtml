{room, key=toplessrobot_kitchen, name=Kitchen
    {enter_message
        output={@
You are in the kitchen.
        }
    }

    {look
        {message
            output={@
You look around.
You are in the kitchen.
            }
        }
    }


    {navigation
        {message
            output={@



---
West, Exit the kitchen.
            }
        }
    }


    {inject, logic=/look.inj }


    {input, syntax=[tplt_syntax]((go_west))
        {move, logic=toplessrobot_room, tags=[player]
            output={@

You exit the kitchen.
            }
        }
    }
}
