{object, key=cruise_health_chip, name=Life Chip, parent=cruise_players_room
    {attrib, tags=moved, output=false }
    {attrib, tags=can_take, output=false }

    {x_desk
        {message
            output={@
You see a chip!
            }
        }

        {logic, logic=[self]((moved)) = 'false' }
        {act, logic=[self]((can_take)), output=true }
    }

    {x_cr_chip
        {message
            output={@
You examine the chip...
It is an xraa_01.05 - these are designed to restore 5 life points to a VR user.

To use it, enter:
use life chip
            }
        }
    }


    {use_chip
        {message
            output={@
Your life has been increased by 5, or restored to the maximum.
            }
        }
    }


    {input, syntax=[tplt_syntax]((x_chip))
        {act, logic=x_cr_chip, tags=!_type|self }
    }

    {input, syntax=[tplt_syntax]((chip_take))
		{move, logic=[player], tags=[self]
			output={@
you take the chip.
			}
		}
        {logic, logic=[self]((can_take)) = 'true'
            {message
                output={@
What are you trying to pick up?
                }
            }
        }
		{set, logic=[self]tags, output=+inventory }
        {set, logic=[self]((moved)), output=true }
    }

    {input, syntax=[tplt_syntax]((chip_drop))
		{move, logic=[room], tags=[self]
			output={@
you drop the chip.
			}
		}
		{set, logic=[self]tags, output=-inventory }
    }


    {input, syntax=[tplt_syntax]((use_life_chip))
        {set, logic=[player]((life)), output=+=5 }
        {set, logic=[player]((life)), output=[player]((maxlife))
            {logic, logic=[player]((life)) > [player]((maxlife)) }
        }
        {act, logic=use_chip, tags=!_type|self }
        {move, logic=!_limbo, tags=[self] }
		{set, logic=[self]tags, output=-inventory }
    }
}
