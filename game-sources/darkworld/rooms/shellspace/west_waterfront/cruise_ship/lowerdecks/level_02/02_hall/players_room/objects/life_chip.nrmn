{object, key=cruise_health_chip, name=Health Chip, parent=cruise_players_room
    {attrib, tags=moved, output=false }
    {attrib, tags=can_take, output=false }

    {x_desk
        {message
            output={@
You see a chip!
            }
        }

        {logic, logic=[self]((moved)) = 'false' }
        {act, logic=[self]((can_take)), output=true }
    }

    {x_cr_chip
        {message
            output={@
You examine the chip...
            }
        }
    }


    {input, syntax=[tplt_syntax]((x_chip))
        {act, logic=x_cr_chip, tags=!_type|self }
    }

    {input, syntax=[tplt_syntax]((chip_take))
		{move, logic=[player], tags=[self]
			output={@
you take the chip.
			}
		}
        {logic, logic=[self]((can_take)) = 'true'
            {message
                output={@
What are you trying to pick up?
                }
            }
        }
		{set, logic=[self]tags, output=+inventory }
        {set, logic=[self]((moved)), output=true }
    }

    {input, syntax=[tplt_syntax]((chip_drop))
		{move, logic=[room], tags=[self]
			output={@
you drop the chip.
			}
		}
		{set, logic=[self]tags, output=-inventory }
    }
}
