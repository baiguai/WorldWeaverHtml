{room, key=cruise_player_bathroom, name=Bathroom
    {attrib, output=true, tags=tested }

    {attrib, tags=navigation
        output={@
West, Back to the main room.
        }
    }

    {enter_message
        output={@
Your room's bathroom is small. A single heat spotlight shines down on you.
There is a small shower behind you, a large lit mirror in front of you.
And next to you is a brushed metal toilet.
        }

        {logic, name=Player's bathroom, tags=!_test
            logic={@
                ?[self]((tested)) = 'true'
            }
        }
    }

    {look
        {message
            output={@
Your room's bathroom is small. A single heat spotlight shines down on you.
There is a small shower behind you, a large lit mirror in front of you.
And next to you is a brushed metal toilet.
            }
        }
    }

    {x_shower
        {message
            output={@
You examine the shower.
It is a glass tube that goes from the floor to the ceiling. A single heat
lamp is set into its center.
            }
        }
    }

    {x_toilet
        {message
            output={@
You examine the toilet. It is sleek and slender but you don't see anything
odd about it.
            }
        }
    }

    {x_mirror
        {message
            output={@
You examine the mirror. It fills the entire wall and has small point lights
along both of its sides.
            }
        }
    }




    {inject, logic=/nav.inj }
    {inject, logic=/look.inj }





    {input, syntax=[tplt_syntax]((x_shower))
        {act, logic=x_shower, tags=!_type|room }
    }

    {input, syntax=[tplt_syntax]((x_toilet))
        {act, logic=x_toilet, tags=!_type|room }
    }

    {input, syntax=[tplt_syntax]((x_mirror))
        {act, logic=x_mirror, tags=!_type|room }
    }

    {input, syntax=[tplt_syntax]((go_west))
        {move, logic=cruise_players_room, tags=[player]
            output={@
You return to the room.
            }
        }
    }
}
