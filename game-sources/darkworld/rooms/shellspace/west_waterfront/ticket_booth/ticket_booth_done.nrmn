{room, key=vice_port_tickets_done, name=Ticket Booth
    {attrib, output=true, tags=tested }
    {attrib, tags=navigation
        output={@
East of where you are takes you back to the waterfront.
        }
    }

    {enter_message
        output={@

The ticket booth consists of multiple hovering neon lights, glowing bright
purple. Overhead is a hovering neon sign that announces: Cruise Ship Tickets

The booth is empty.
        }

        {logic, name=Cruise ticket booth done, tags=!_test
            logic={@
                ?[self]((tested)) = 'true'
            }
        }
    }

    {look
        {message
            output={@
You look around. The glowing neon ticket booth is just before you.
            }
        }
    }

    {x_booth
        {message
            output={@
The ticket booth consists of multiple hovering neon lights, glowing bright
purple. Overhead is a hovering neon sign that announces: Cruise Ship Tickets

The booth is currently empty.
            }
        }
    }




    {inject, logic=/nav.inj }
    {inject, logic=/look.inj }


    {input, syntax=[tplt_syntax]((x_ticket_booth))
        {act, logic=x_booth, tags=!_type|room }
    }

    {input, syntax=[tplt_syntax]((go_east))
        {move, logic=waterfront_west, tags=[player]
            output={@
You return to the waterfront.
            }
        }
    }
}
