{room, key=deepgrid_gen_floor, name=Hallway
    {attrib, output=false, tags=tested }
    {attrib, tags=navigation
        output={@
Elevator enters the elevator.
        }
    }


    {enter_message
        output={@
A long hallway stretches out before you.
There are doors lining either side. You test a handful of them,
but they are all locked.

        }

        {action, output=[room], tags=!_spawn, logic=rmrf_assassin
            {attack, logic=((rmrf_assassin)), tags=player
                output={@
You see a shadowy man in a black suit.
Where his eyes would be is a band of chrome with a red light
slowly moving from side to side.

He is staring at you. Then he pulls a lazer gun and shoots.
                }
            }

            {logic
                logic={@
                    ?rdm_[roll:1d6] > '4'
                }
            }
        }

        {logic, name=Deepgrid elevator tested, tags=!_test
            logic={@
                ?[self]((tested)) = 'true'
            }
        }
    }


    {look
        {message
            output={@
A long hallway stretches out before you.
There are doors lining either side. You test a handful of them,
but they are all locked.

            }
        }
    }



    {inject, logic=/nav.inj }
    {inject, logic=/look.inj }



    {input, syntax=[tplt_syntax]((elevator))
        {move, logic=deepgrid_elevator, tags=[player]
            output={@
You press the elevator button. A moment later, one of the doors slide open.
You step inside.
            }
        }
    }
}
