{room, key=cult_temple, name=Temple
    {attrib, output=false, tags=tested }
    {attrib, tags=navigation
        output={@
hall - leave the temple.
        }
    }


    {enter_message
        output={@
You find yourself in what appears to be a vast temple.
Chairs line the left and right walls of the temple, with
a path leading forward to an alter.
Just behind the alter, hovering in air, is a large, purple, neon circle lighting
up the entire space.

Bowing before the circle you see hooded figures.

        }

        {logic, name=Deepgrid cult temple tested, tags=!_test
            logic={@
                ?[self]((tested)) = 'true'
            }
        }
    }

    {look
        {message
            output={@
You look around...

Chairs line the left and right walls of the temple.
There is an alter.
Just behind the alter, hovering in air, is a large, purple, neon circle lighting
up the entire space.

Bowing before the circle you see hooded figures.

            }
        }
    }


    {inject, logic=/nav.inj }
    {inject, logic=/look.inj }



    {input, syntax=[tplt_syntax]((hall))
        {move, logic=mailroom_closet, tags=[player]
            output={@
You return to the back of the temple where the narrow hall was and enter.

            }
        }
    }
}
