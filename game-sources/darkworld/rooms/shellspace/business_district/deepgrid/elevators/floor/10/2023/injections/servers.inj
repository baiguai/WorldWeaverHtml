{x_servers
    {message
        output={@
You examine the servers in the rack.
They are unlike any computers you've ever seen before. This makes sense
since you are in a virtual world. Raw binary messages flicker across small
displays on the front of the thin machines.

        }
    }
}

{x_behind_servers
    {message
        output={@
You don't see anything behind the server rack.
It is spotlessly clean. You're not sure you will ever get used to the absence
of dust due to being in a virtual world.

        }
    }
}
{x_on_servers
    {message
        output={@
You examine the top of the server rack. It is pretty tall so it's difficult to see.
But you don't notice anything there.

        }
    }
}
{x_under_servers
    {message
        output={@
You crouch down and look under the servers. You don't see anything. Not even dust.

        }
    }
}



{input, syntax=[tplt_syntax]((x_servers))
    {act, logic=x_servers, tags=!_type|room }
}
{input, syntax=[tplt_syntax]((x_behind_servers))
    {act, logic=x_behind_servers, tags=!_type|room }
}
{input, syntax=[tplt_syntax]((x_on_servers))
    {act, logic=x_on_servers, tags=!_type|room }
}
{input, syntax=[tplt_syntax]((x_under_servers))
    {act, logic=x_under_servers, tags=!_type|room }
}
