{secrets
    {message
        output={@

"A hacker friend of mine..."
He looks around nervously,
"Accidentally uncovered a thread. There was a post that mentioned something called Retrograde.
Weird thing is - it was posted by Holographic LTD. Have you ever heard of that company?

And what is Retrograde?"
        }

        {set, logic=[self]((secrets_answered)), output=true }
    }

    {logic
        logic={@
            ?[self]((secrets_answered)) = 'false'
        }
        output={@
"That's all I know... for all you know."
        }
    }
}






{input, syntax=[tplt_syntax]((conv_secrets))
    {act, logic=secrets, tags=!_type|room }

    {logic
        logic={@
            ?[self]((topic)) = 'smalltalk'
            and
            ?[self]((step)) = 'help'
        }
        output={@

"Huh?"
        }
    }
}
