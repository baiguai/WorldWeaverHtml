{room, key=meat_garage, name=Garage
    {attrib, output=true, tags=tested }
    {attrib, tags=navigation
        output={@
West: living room
        }
    }

    {enter_message
        {act, logic=story, tags=!_type|room }
    }

    {story
        {message
            output={@

The garage is large and overhead are two big white spherical lights.
Along the north wall is a workbench with drawers beneath it.

The rest of the garage is open and empty.

            }
        }
    }

    {look
        {message
            output={@

The garage is empty. There are no cars parked in it.
Overhead are two large spherical lights hanging from the ceiling.
And along the north wall is a workbench.

            }
        }

        {logic, name=Garage tested, tags=!_test
            logic={@
                ?[self]((tested)) = 'true'
            }
        }
    }

    {x_workbench
        {message
            output={@

You examine the workbench.
There are some tools strewn across its surface.
In the center is a single wide drawer.

            }
        }
    }

    {x_drawer
        {message
            output={@

You examine the drawer.
It is empty except for a small piece of paper.
You pick it up and read it:

**aphelion**

            }
        }
    }


    {inject, logic=/nav.inj }
    {inject, logic=/look.inj }




    {input, syntax=[tplt_syntax]((go_west))
        {move, logic=meat_living_room, tags=[player]
            output={@

You go back to the living room.

            }
        }
    }

    {input, syntax=[tplt_syntax]((x_workbench))
        {act, logic=x_workbench, tags=!_type|room }
    }

    {input, syntax=[tplt_syntax]((x_drawer))
        {act, logic=x_drawer, tags=!_type|room }
    }


    
    
    {dev_note, tags=Testing, active=true
        output={@
[X] : Room
[X] : Look
[X] : Story

[X] : Navigation
        }
    }
}
