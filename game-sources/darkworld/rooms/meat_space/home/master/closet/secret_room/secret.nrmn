{room, key=meat_closet_secret, name=Secret Room
    {attrib, output=true, tags=tested }
    {attrib, output=false, tags=lights_on }
    {attrib, tags=navigation
        output={@
East: back to the closet
        }
    }

    {enter_message
        {act, logic=story, tags=!_type|room }
    }

    {story
        {message
            output={@

You find yourself in a small room.
<?[room]((lights_on)) = 'false'?>
In the near darkness you can just see a dark shape near the far wall.
<else>
Near the far wall stands a shapely female android.
</?>

            }
        }
    }

    {look
        {message
            output={@

You are in a small room.
<?[room]((lights_on)) = 'false'?>
In the near darkness you can just see a dark shape near the far wall.
<else>
The walls, floor and ceiling are made of brushed steel like the door.
Overhead a single spotlight shines down casting stark shadows.

Near the far wall stands a shapely female android.
She is wearing a maid's dress that is very revealing.
Her eyes are dark, she is not activated.
</?>

            }
        }

        {logic, name=Secret Closet Room tested, tags=!_test
            logic={@
                ?[self]((tested)) = 'true'
            }
        }
    }

    {inv_room
        {message
            output={@

You feel around the walls of the room, in the darkness.
You encounter a light switch that you can turn on.

            }
        }
    }


    {inject, logic=./objects/android.inj }
    {inject, logic=/nav.inj }
    {inject, logic=/look.inj }




    {input, syntax=[tplt_syntax]((turn_light_on))
        {set, logic=[room]((lights_on)), output=true }
        {message
            output={@

You turn the light on.

            }
        }
    }

    {input, syntax=[tplt_syntax]((turn_light_off))
        {set, logic=[room]((lights_on)), output=false }
        {message
            output={@

You turn the light off.

            }
        }
    }

    {input, syntax=[tplt_syntax]((inv_room))
        {act, logic=inv_room, tags=!_type|room }
    }

    {input, syntax=[tplt_syntax]((go_east))
        {move, logic=meat_master_closet, tags=[player]
            output={@

You return to the closet.

            }
        }
    }


    
    
    {dev_note, tags=Testing, active=true
        output={@
[X] : Room
[X] : Look
[X] : Story

[X] : Navigation
        }
    }
}
