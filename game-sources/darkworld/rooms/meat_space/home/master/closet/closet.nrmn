{room, key=meat_master_closet, name=Closet
    {attrib, output=false, tags=tested }
    {attrib, tags=navigation
        output={@
North: back to the master bedroom
West: secret room
        }
    }

    {enter_message
        {act, logic=story, tags=!_type|room }
    }

    {story
        {message
            output={@

You are in the walk in closet.
There is a barely noticeable door in the west wall.

            }
        }
    }

    {look
        {message
            output={@

You see lots of clothes and a display table in the center with ties and watches
in it.
Set into the west wall is a small door that you can barely see.

            }
        }

        {logic, name=Closet tested, tags=!_test
            logic={@
                ?[self]((tested)) = 'true'
            }
        }
    }


    {inject, logic=/nav.inj }
    {inject, logic=/look.inj }




    {input, syntax=[tplt_syntax]((go_north))
        {move, logic=meat_master_bedroom, tags=[player]
            output={@

You return to your parents' bedroom.

            }
        }
    }

    {input, syntax=[tplt_syntax]((go_west))
        {move, logic=meat_closet_secret, tags=[player]
            output={@

You enter the secret room.

            }
        }
    }
    
    
    {dev_note, tags=Testing, active=true
        output={@
[ ] : Room
[ ] : Look
[ ] : Story

[ ] : Navigation
        }
    }
}
