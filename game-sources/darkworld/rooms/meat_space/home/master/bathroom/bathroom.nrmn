{room, key=meat_master_bathroom, name=Master Bathroom
    {attrib, output=true, tags=tested }
    {attrib, tags=navigation
        output={@
East: master bedroom
        }
    }

    {enter_message
        {act, logic=story, tags=!_type|room }
    }

    {story
        {message
            output={@

The bathroom is very luxurious.
There are small spotlights overhead and the entire room is lined with slate tiles.

            }
        }
    }

    {look
        {message
            output={@

There are two sinks and a large mirror along the west wall.
In the north east corner of the room is a large oval bathtub.
The toilet is in a separated stall in the south west corner.
And in the south end of the room is an expansive shower in a glass enclosure.

            }
        }

        {logic, name=Bathroom tested, tags=!_test
            logic={@
                ?[self]((tested)) = 'true'
            }
        }
    }


    {inject, logic=/nav.inj }
    {inject, logic=/look.inj }

    {inject, logic=./objects/sinks.inj }
    {inject, logic=./objects/bathtub.inj }
    {inject, logic=./objects/toilet.inj }
    {inject, logic=./objects/shower.inj }



    {input, syntax=[tplt_syntax]((go_east))
        {move, logic=meat_master_bedroom, tags=[player]
            output={@

You return to your parents' bedroom...

            }
        }
    }


    
    {dev_note, tags=Testing, active=true
        output={@
[X] : Room
[X] : Look
[X] : Story

[X] : Navigation
        }
    }
}
