{x_chair
    {message
        output={@

You examine the sitting area chair.
It is made of rich dark wood and black leather.

        }
    }
}

{x_on_chair
    {message
        output={@

There is nothing sitting on the chair.

        }
    }
}

{x_under_chair
    {message
        output={@

