{room, key=meat_living_room, name=Living Room
    {attrib, output=false, tags=tested }
    {attrib, tags=navigation
        output={@
West: hallway
South: kitchen
East: garage
        }
    }

    {enter_message
        {act, logic=story, tags=!_type|room }
    }

    {story
        {message
            output={@

The entire living room is done in mid-century modern style.
In the center is a massive conversation pit with a floating fireplace in the
center.

In the northwest corner is a fully stocked bar.

            }
        }
    }

    {look
        {message
            output={@

In the middle of the living room is a large conversation pit with a fireplace
in the center.

In the northwest corner is the bar.
Opposite that, in the northeast corner is a massive TV mounted to the wall.

In the east is the door to the garage and in the south wall is the door to
the kitchen.

The hallway is in the southwest corner of the living room.

            }
        }

        {logic, name=Living Room tested, tags=!_test
            logic={@
                ?[self]((tested)) = 'true'
            }
        }
    }


    {inject, logic=./objects/bar.inj }
    {inject, logic=./objects/conv_pit.inj }
    {inject, logic=./objects/tv.inj }


    {inject, logic=/nav.inj }
    {inject, logic=/look.inj }






    {input, syntax=[tplt_syntax]((go_west))
        {move, logic=meat_hallway, tags=[player]
            output={@

You return to the hallway.

            }
        }
    }

    {input, syntax=[tplt_syntax]((go_south))
        {move, logic=meat_kitchen, tags=[player]
            output={@

You step into the kitchen.

            }
        }
    }

    {input, syntax=[tplt_syntax]((go_east))
        {move, logic=meat_garage, tags=[player]
            output={@

You enter the garage.

            }
        }
    }




    
    {dev_note, tags=Testing, active=true
        output={@
[X] : Room
[X] : Look
[X] : Story
[X] : Bar
[X] : Conversation Pit
[X] : Television

[ ] : Navigation
        }
    }
}
