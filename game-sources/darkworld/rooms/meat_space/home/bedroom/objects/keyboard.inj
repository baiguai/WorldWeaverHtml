{object, name=Keyboard
    {x_on_desk
        {message
            output={@

You see a keyboard.
            }
        }
    }

    {x_keyboard
        {message
            output={@

The keyboard seems to be a fairly mundane gamer's input device.
             }
        }
    }

    {x_under_keyboard
        {message
            output={@

You look under the keyboard.
Taped to the desk under it is a small bit of paper.
Written on it is:

^^ RMRF
            }
        }
    }



    {input, syntax=[tplt_syntax]((x_keyboard))
        {act, logic=x_keyboard, tags=!_type|room }
    }

    {input, syntax=[tplt_syntax]((x_under_keyboard))
        {act, logic=x_under_keyboard, tags=!_type|room }
    }
}
