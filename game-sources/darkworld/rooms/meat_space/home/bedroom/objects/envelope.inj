{object, name=Envelope
    {x_on_desk
        {message
            output={@

You see an envelope.
            }
        }
    }

    {x_envelope
        {message
            output={@

You examine the envelope.
Inside is the USB stick you've been waiting for!
You can put the USB in your computer.
            }
        }
    }

    {go_vr
        {message
            output={@

You go to Shellspace!!!!
            }
        }
    }





    {input, syntax=[tplt_syntax]((x_envelope))
        {act, logic=x_envelope, tags=!_type|room }
    }

    {input, syntax=[tplt_syntax]((plug_in_usb))
        {act, logic=go_vr, tags=!_type|room }
    }
}
