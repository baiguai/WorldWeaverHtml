{object, key=mt_cd, name=CD, parent=bedroom
    {attrib, output=false, tags=moved }

    {x_on_desk
        {message
            output={@

You see a CD.
            }
        }

        {logic
            logic={@
                ?[self]((moved)) = 'false'
            }
        }
    }

    {put_cd
        {message
            output={@

You put the CD in the CD player.
A dark and mellow song begins to play. The sultry female voice sings:

^^ I thought I loved you but I only loved the idea of you.
I thought you loved me but your love was a stack of layers.
They had little to do with me.
The deepest one was predatory.
It took my heart.
Each level fed and passed on the rest.
In the end there was nothing left.
            }
        }
    }




    {input, syntax=[tplt_syntax]((put_cd_in_player))
        {act, logic=put_cd, tags=!_type|room }
        {set, output=true, logic=[self]((moved)) }

        {logic
            logic={@
                ?[mt_cd_player]parent = [player]
            }
            output={@

You aren't carrying a CD player.
            }
        }

        {logic
            logic={@
                ?[self]((moved)) = 'false'
            }
            output={@

The CD is already in the player.
            }
        }
    }
}
