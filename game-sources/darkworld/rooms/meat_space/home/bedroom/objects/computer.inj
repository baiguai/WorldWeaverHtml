{object, name=Computer
    {x_on_desk
        {message
            output={@

You see your computer.
            }
        }
    }

    {x_computer
        {message
            output={@

You examine your computer...
            }
        }
    }



    {input, syntax=[tplt_syntax]((x_computer))
        {act, logic=x_computer, tags=!_type|room }
    }
}
