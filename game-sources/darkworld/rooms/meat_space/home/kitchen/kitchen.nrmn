{room, key=meat_kitchen, name=Kitchen
    {attrib, output=false, tags=tested }
    {attrib, tags=navigation
        output={@
North: living room
West: pantry
        }
    }

    {enter_message
        {act, logic=story, tags=!_type|room }
    }

    {story
        {message
            output={@

In the west wall is a small door to the pantry.
Along the south wall is a long counter with sinks and a stove.
In the northeast corner is a small dining room table and chairs.

            }
        }
    }

    {look
        {message
            output={@

The kitchen is bright and gives the vibes of spring.
The south wall is mostly comprised of bay windows and angled skylights above.
The west wall is where the pantry is and running the width of the south wall
is the counter with a refrigerator, sinks, and a stove.

A small dining area is set up in the north east corner of the room, just
beyond a stand up freezer.

            }
        }

        {logic, name=Kitchen tested, tags=!_test
            logic={@
                ?[self]((tested)) = 'true'
            }
        }
    }


    {inject, logic=/nav.inj }
    {inject, logic=/look.inj }

    {inject, logic=./objects/dining.inj }
    {inject, logic=./objects/freezer.inj }
    {inject, logic=./objects/fridge.inj }
    {inject, logic=./objects/sink.inj }
    {inject, logic=./objects/stove.inj }



    {input, syntax=[tplt_syntax]((go_north))
        {move, logic=meat_living_room, tags=[player]
            output={@

You return to the living room.

            }
        }
    }

    {input, syntax=[tplt_syntax]((go_west))
        {move, logic=meat_pantry, tags=[player]
            output={@

You step into the pantry.

            }
        }
    }



    
    {dev_note, tags=Testing, active=true
        output={@
[ ] : Room
[X] : Look
[X] : Story

[ ] : Navigation
        }
    }
}
