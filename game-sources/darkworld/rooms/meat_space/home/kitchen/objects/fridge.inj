{x_fridge
    {message
        output={@

You open the fridge and look inside.
Strangely it is COMPLETELY empty.

        }
    }
}

{x_on_fridge
    {message
        output={@

You don't see anything on top of the fridge.

        }
    }
}

{x_behind_fridge
    {message
        output={@

Besides dust there isn't anything behind the refrigerator.

        }
    }
}

{x_under_fridge
    {message
        output={@

There isn't anything under the fridge.

        }
    }
}







