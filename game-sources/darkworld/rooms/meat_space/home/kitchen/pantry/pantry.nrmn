{room, key=meat_pantry, name=Pantry
    {attrib, output=true, tags=tested }
    {attrib, tags=navigation
        output={@
East: kitchen
        }
    }

    {enter_message
        {act, logic=story, tags=!_type|room }
    }

    {story
        {message
            output={@

The pantry is stocked full of containers of emergency supplies as well as
various pasta noodles and spices.

However, as you inspect them you realize that **everything** in the pantry
is completely empty.

            }
        }
    }

    {look
        {message
            output={@

The pantry is filled with oddly empty containers and packages and spices.

            }
        }

        {logic, name=Pantry tested, tags=!_test
            logic={@
                ?[self]((tested)) = 'true'
            }
        }
    }


    {inject, logic=/nav.inj }
    {inject, logic=/look.inj }



    {input, syntax=[tplt_syntax]((go_east))
        {move, logic=meat_kitchen, tags=[player]
            output={@

You return to the kitchen.

            }
        }
    }


    
    {dev_note, tags=Testing, active=true
        output={@
[X] : Room
[X] : Look
[X] : Story

[X] : Navigation
        }
    }
}
