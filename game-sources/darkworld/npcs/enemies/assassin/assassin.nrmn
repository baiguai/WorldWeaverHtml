{npc, key=rmrf_assassin, name=Assassin, tags=enemy
	{attrib, logic=spn_[rand:3|4], tags=stats_dice }
	{attrib, output=spn_[rand:<<[self]((stats_dice))>>|4], tags=life_roll }
	{attrib, output=spn_[rand:<<[self]((stats_dice))>>|5], tags=armor_roll }
	{attrib, name=Life, output=spn_[roll:<<[self]((life_roll))>>d4], tags=stats|!_life }
	{attrib, output=spn_[roll:(6)<<[self]((armor_roll))>>d4+3], tags=stats|armor }
	{attrib, output=<<[self]((armor))>>, tags=!_hitscore }
	{attrib, output=0, tags=!_damageadj }

	{attrib, output=assn_gun_01, tags=!_armed|name }
	{attrib, tags=!_hitmsg
		output={@
You have hit the man.

		}
	}
	{attrib, tags=!_missmsg
		output={@
You have attacked the man, but missed.

		}
	}
	{attrib, tags=!_killmsg
		output={@
You have killed the man.

		}
	}

	{attrib, tags=!_hitplayermsg
		output={@
The man has attacked you!

		}
	}

	{attrib, tags=!_missplayermsg
		output={@
The man has attacked you, but missed.

		}
	}

	{look
		{message
			output={@

You see a shadowy man in a black suit.

			}
		}
	}

	{input, syntax=(attack.*man|!.*man)
		{attack, logic=[self] }
	}


	{object, key=assn_gun_01, tags=!_weapon
		{attrib, logic=rdm_[roll:(2)1d6], tags=!_damage }
		{attrib, output=gun, tags=title }
	}
}
}
