{npc, key=bus_robot, name=Robot, parent=business_northwest
    {attrib, output=greeting, tags=topic }

    {enter_message
        output={@

You see a robot.
It is tall, over two meters. Its entire body is chrome and it has been built
in the shape of a woman. There is a thin glowing band of purple light that
comprises its eyes and two small antennae jut from its head where its ears
would be.
        }
    }

    {look
        {message, repeat=none
            {message
                output={@

The robot approaches you.
"Greetings friend. How are you doing on this fine evening?"
<?[player]((knows_about_killing)) = 'false' ?>
The robot leans in close to you.
"They're killing people in meat space."
<else>
"I know who you are! I assume you are here to take on..."
The robot looks around... "the RMRF."
</?>

<?[lazer_gun]parent != [player]?>
"This is a dangerous place. Here, have a lazer gun."
</?>
                }
            }
            {message
                output={@

There is a robot standing next to you.
<?[player]((knows_about_killing)) = 'false' ?>
"Like I said, they're killing people in meat space."
<else>
"I assume you are here to take on the RMRF."
</?>
                }
            }
        }
    }

    {x_robot
        {message
            output={@
You examine the robot...
            }
        }

        {move, logic=[player], tags=[self]
            output={@
The robot gives you a lazer gun.
            }
        }
        {set, logic=[self]tags, output=+inventory }
        {set, logic=[self]((moved)), output=true }
    }



    {input, syntax=[tplt_syntax]((x_robot))
        {act, logic=x_robot, tags=!_type|self }
    }
}
