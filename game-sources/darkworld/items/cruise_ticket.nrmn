{object, key=cruise_ticket, name=Cruise Ticket
    {attrib, output=false, tags=purchased }

    {look
        {message
            output={@
You see a cruise ticket.
            }
        }

        {logic
            logic={@
                ?[self]parent = [room]
            }
        }
    }

    {inject, logic=/look.inj }
}
