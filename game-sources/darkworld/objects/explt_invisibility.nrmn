{object, key=explt_invisibility, name=Invisibility Exploit, parent=!_limbo
    {attrib, output=false, tags=active }
    {attrib, output=0, tags=active_rounds }

    {x_invisibility
        {message
            output={@

The invisibility exploit has been loaded into your core functionality.
To use it:

**inv_exp**

            }
        }

        {logic
            logic={@
                ?[self]parent = [player]
            }
            {output={@

I'm not sure what you're talking about.

            }
        }
    }

    {use_invisibility
        {message
            output={@

You activate the invisibility exploit.

            }
        }
    }




    {input, syntax=[tplt_syntax]((x_invisibility_explt))
        {act, logic=x_invisibility, tags=!_type|self }

        {logic
            logic={@
                ?[self]parent = [player]
            }
            output={@

What are you trying to examine?

            }
        }
    }

    {input, syntax=[tplt_syntax]((use_inv_explt))
        {act, logic=use_invisibility, tags=!_type|self }
        {set, logic=[self]((active)), output=true }

        {logic
            logic={@
                ?[self]parent = [player]
            }
            output={@

What are you trying to do?

            }
        }
    }
}
